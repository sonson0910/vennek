{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@vennek/shared": ["packages/shared/src/index.ts"],
      "@vennek/cardano-governance-skills": ["packages/cardano-governance-skills/src/index.ts"],
      "@vennek/cardano-agent": ["packages/cardano-agent/src/index.ts"],
      "@vennek/telegram-bot": ["apps/telegram-bot/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
