{
  "name": "vennek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p packages/shared/tsconfig.build.json && tsc -p packages/cardano-governance-skills/tsconfig.build.json && tsc -p packages/cardano-agent/tsconfig.build.json && tsc -p apps/telegram-bot/tsconfig.build.json",
    "verify:imports": "node -e \"Promise.all([import('@vennek/shared'), import('@vennek/cardano-governance-skills'), import('@vennek/cardano-agent'), import('@vennek/telegram-bot')]).then(() => console.log('package imports ok'))\"",
    "migrate:agent": "tsx scripts/migrate-agent.ts",
    "health": "node apps/telegram-bot/dist/main.js --health",
    "start:telegram": "node apps/telegram-bot/dist/main.js --poll",
    "provision:app-role": "tsx scripts/provision-app-role.ts",
    "provision:knowledge-role": "tsx scripts/provision-knowledge-role.ts",
    "demo": "tsx scripts/run-demo.ts",
    "validate:sources": "tsx scripts/validate-data-sources.ts --mode sample --write-report",
    "validate:sources:live": "tsx scripts/validate-data-sources.ts --mode live --write-report",
    "eval:citations": "tsx scripts/evaluate-citations.ts --write-report",
    "staging:smoke": "tsx scripts/staging-smoke.ts",
    "proof:fixture": "tsx scripts/create-proof-fixture.ts",
    "validate:registry": "tsx scripts/validate-source-registry.ts",
    "validate:registry:live": "tsx scripts/validate-source-registry.ts --live",
    "eval:cardano-rag": "tsx scripts/evaluate-cardano-rag.ts --offline",
    "eval:cardano-rag:live": "tsx scripts/evaluate-cardano-rag.ts --live",
    "verify:pdf-extractor-compose": "tsx scripts/verify-pdf-extractor-compose.ts",
    "verify:private-extractor-compose": "tsx scripts/verify-private-extractor-compose.ts --smoke",
    "verify:private-worker-smoke": "tsx scripts/verify-private-worker-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/yauzl": "2.10.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  }
}
