[Unit]
Description=Vennek Telegram Governance Copilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vennek
EnvironmentFile=/etc/vennek/vennek.env
ExecStart=/usr/bin/node apps/telegram-bot/dist/main.js --poll
Restart=on-failure
RestartSec=5
User=vennek
Group=vennek
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vennek

[Install]
WantedBy=multi-user.target
