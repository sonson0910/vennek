# Local polling example only; production uses docker-compose webhook/worker.
# File mode must be 0600. Do not commit real values.
DATABASE_URL=postgresql://vennek_app:replace-with-a-long-app-password@127.0.0.1:5432/vennek
DATABASE_KNOWLEDGE_URL=postgresql://vennek_knowledge:replace-with-a-long-knowledge-password@127.0.0.1:5432/vennek
# Internal live-discovery promotion boundary.
KNOWLEDGE_PROMOTION_KEY_ID=agent-worker-v1
KNOWLEDGE_PROMOTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
KNOWLEDGE_PROMOTION_PORT=8082
KNOWLEDGE_PROMOTION_URL=http://knowledge-worker:8082
SEARXNG_BASE_URL=https://search.example.test/

VENNEK_KNOWLEDGE_DB_USER=vennek_knowledge
VENNEK_KNOWLEDGE_DB_PASSWORD=replace-with-a-long-knowledge-password
VENNEK_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=replace-with-litellm-key
PRIVATE_DOCUMENT_EXTRACTOR_URL=http://private-document-extractor:8083
PRIVATE_DOCUMENT_EXTRACTOR_TOKEN=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
VENNEK_MODEL_FAST=cardano-fast
VENNEK_MODEL_QUALITY=cardano-quality
VENNEK_MODEL_VERIFIER=cardano-verifier
VENNEK_EMBEDDING_MODEL=cardano-embedding
VENNEK_PRIVATE_MODEL_QUALITY=cardano-private-quality
VENNEK_PRIVATE_MODEL_VERIFIER=cardano-private-verifier
PRIVATE_OPENAI_API_KEY=replace-with-private-openai-key
PRIVATE_OPENAI_QUALITY_MODEL=replace-with-approved-private-quality-model
PRIVATE_OPENAI_VERIFIER_MODEL=replace-with-approved-private-verifier-model
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
VENNEK_ENABLE_FIXTURES=false
VENNEK_DATA_DIR=/var/lib/vennek
BLOCKFROST_PROJECT_ID=
BLOCKFROST_NETWORK=preprod
BLOCKFROST_TEST_TX_HASH=
BLOCKFROST_TEST_CONTENT_HASH=
