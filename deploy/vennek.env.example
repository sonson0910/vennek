# Local polling example only; production uses docker-compose webhook/worker.
# File mode must be 0600. Do not commit real values.
DATABASE_URL=postgresql://vennek_app:replace-with-a-long-app-password@127.0.0.1:5432/vennek
VENNEK_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=replace-with-litellm-key
VENNEK_MODEL_FAST=cardano-fast
VENNEK_MODEL_QUALITY=cardano-quality
VENNEK_MODEL_VERIFIER=cardano-verifier
VENNEK_EMBEDDING_MODEL=cardano-embedding
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
VENNEK_ENABLE_FIXTURES=false
VENNEK_DATA_DIR=/var/lib/vennek
BLOCKFROST_PROJECT_ID=
BLOCKFROST_NETWORK=preprod
BLOCKFROST_TEST_TX_HASH=
BLOCKFROST_TEST_CONTENT_HASH=
