# Copy this file to a mode-0600 secret file. Every value below is a placeholder.
# Generate VENNEK_ENCRYPTION_KEY with the command in docs/deployment/telegram-runtime.md.

POSTGRES_DB=vennek
POSTGRES_PORT=5432
POSTGRES_OWNER_USER=vennek_owner
POSTGRES_OWNER_PASSWORD=replace-with-a-long-owner-password
VENNEK_IMAGE=vennek
VENNEK_IMAGE_TAG=replace-with-immutable-image-tag
VENNEK_APP_DB_USER=vennek_app
VENNEK_APP_DB_PASSWORD=replace-with-a-long-app-password
VENNEK_KNOWLEDGE_DB_USER=vennek_knowledge
VENNEK_KNOWLEDGE_DB_PASSWORD=replace-with-a-long-knowledge-password
DATABASE_OWNER_URL=postgresql://vennek_owner:replace-with-a-long-owner-password@postgres:5432/vennek
DATABASE_APP_URL=postgresql://vennek_app:replace-with-a-long-app-password@postgres:5432/vennek
DATABASE_KNOWLEDGE_APP_URL=postgresql://vennek_knowledge:replace-with-a-long-knowledge-password@postgres:5432/vennek
# For local commands outside Compose, point DATABASE_URL at the application role.
DATABASE_URL=postgresql://vennek_app:replace-with-a-long-app-password@127.0.0.1:5432/vennek

# Internal live-discovery promotion boundary.
KNOWLEDGE_PROMOTION_KEY_ID=agent-worker-v1
KNOWLEDGE_PROMOTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
KNOWLEDGE_PROMOTION_PORT=8082
KNOWLEDGE_PROMOTION_URL=http://knowledge-worker:8082
SEARXNG_BASE_URL=https://search.example.test/

VENNEK_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-url-safe-characters
WEBHOOK_PORT=8080

# Vennek receives only its database URL, LiteLLM endpoint/API key, and model
# aliases. Provider keys below are LiteLLM-only and never enter Vennek,
# the evaluator, or live reports.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-with-litellm-master-key
LITELLM_API_KEY=replace-with-litellm-master-key
# The current cardano-embedding alias uses OpenAI text-embedding-3-small
# (1,536 dimensions). Staging needs a real OPENAI_API_KEY in LiteLLM's own
# mode-0600 secret file/manager; keep this example value as a placeholder.
OPENAI_API_KEY=replace-with-openai-key
PRIVATE_OPENAI_API_KEY=replace-with-private-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Anthropic/Gemini are optional LiteLLM completion fallbacks, not Vennek or
# evaluator credentials.
ANTHROPIC_API_KEY=replace-with-anthropic-key
GEMINI_API_KEY=replace-with-gemini-key
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o
OPENAI_VERIFIER_MODEL=gpt-4o-mini
ANTHROPIC_FAST_MODEL=anthropic/claude-3-5-haiku-latest
ANTHROPIC_QUALITY_MODEL=anthropic/claude-3-5-sonnet-latest
ANTHROPIC_VERIFIER_MODEL=anthropic/claude-3-5-haiku-latest
GEMINI_FAST_MODEL=gemini/gemini-2.0-flash
GEMINI_QUALITY_MODEL=gemini/gemini-2.5-pro
GEMINI_VERIFIER_MODEL=gemini/gemini-2.0-flash
PRIVATE_OPENAI_QUALITY_MODEL=replace-with-approved-private-quality-model
PRIVATE_OPENAI_VERIFIER_MODEL=replace-with-approved-private-verifier-model
VENNEK_MODEL_FAST=cardano-fast
VENNEK_MODEL_QUALITY=cardano-quality
VENNEK_MODEL_VERIFIER=cardano-verifier
VENNEK_EMBEDDING_MODEL=cardano-embedding

# Internal-only PDF extraction service. Generate a fresh 32-byte base64url token for deployment.
PDF_EXTRACTOR_URL=http://pdf-extractor:8081
PDF_EXTRACTOR_TOKEN=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
PRIVATE_DOCUMENT_EXTRACTOR_URL=http://private-document-extractor:8083
PRIVATE_DOCUMENT_EXTRACTOR_TOKEN=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
VENNEK_PRIVATE_MODEL_QUALITY=cardano-private-quality
VENNEK_PRIVATE_MODEL_VERIFIER=cardano-private-verifier
# Optional worker-only GitHub capacity; it is never a live RAG gate.
GITHUB_TOKEN=

# Local demos/tests only. Do not enable in production.
VENNEK_ENABLE_FIXTURES=false
VENNEK_DATA_DIR=./data

# Optional Cardano live data integrations.
BLOCKFROST_PROJECT_ID=
BLOCKFROST_NETWORK=mainnet
KOIOS_API_URL=
