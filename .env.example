# Copy this file to a mode-0600 secret file. Every value below is a placeholder.
# Generate VENNEK_ENCRYPTION_KEY with the command in docs/deployment/telegram-runtime.md.

POSTGRES_DB=vennek
POSTGRES_PORT=5432
POSTGRES_OWNER_USER=vennek_owner
POSTGRES_OWNER_PASSWORD=replace-with-a-long-owner-password
VENNEK_APP_DB_USER=vennek_app
VENNEK_APP_DB_PASSWORD=replace-with-a-long-app-password
DATABASE_OWNER_URL=postgresql://vennek_owner:replace-with-a-long-owner-password@postgres:5432/vennek
DATABASE_APP_URL=postgresql://vennek_app:replace-with-a-long-app-password@postgres:5432/vennek
# For local commands outside Compose, point DATABASE_URL at the application role.
DATABASE_URL=postgresql://vennek_app:replace-with-a-long-app-password@127.0.0.1:5432/vennek

VENNEK_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-url-safe-characters
WEBHOOK_PORT=8080

LITELLM_MASTER_KEY=replace-with-litellm-master-key
LITELLM_API_KEY=replace-with-litellm-master-key
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
GEMINI_API_KEY=replace-with-gemini-key
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o
OPENAI_VERIFIER_MODEL=gpt-4o-mini
ANTHROPIC_FAST_MODEL=anthropic/claude-3-5-haiku-latest
ANTHROPIC_QUALITY_MODEL=anthropic/claude-3-5-sonnet-latest
ANTHROPIC_VERIFIER_MODEL=anthropic/claude-3-5-haiku-latest
GEMINI_FAST_MODEL=gemini/gemini-2.0-flash
GEMINI_QUALITY_MODEL=gemini/gemini-2.5-pro
GEMINI_VERIFIER_MODEL=gemini/gemini-2.0-flash
VENNEK_MODEL_FAST=cardano-fast
VENNEK_MODEL_QUALITY=cardano-quality
VENNEK_MODEL_VERIFIER=cardano-verifier

# Local demos/tests only. Do not enable in production.
VENNEK_ENABLE_FIXTURES=false
VENNEK_DATA_DIR=./data

# Optional Cardano live data integrations.
BLOCKFROST_PROJECT_ID=
BLOCKFROST_NETWORK=mainnet
KOIOS_API_URL=
