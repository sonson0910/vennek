# Required for Telegram polling mode
TELEGRAM_BOT_TOKEN=

# Required only for polling: comma-separated direct/group Telegram chat IDs.
# Polling fails closed when missing or invalid; CLI and health are unaffected.
VENNEK_TELEGRAM_ALLOWED_CHAT_IDS=

# Optional but recommended for durable audit/source/proof/runtime state
VENNEK_DATA_DIR=./data

# Local demos/tests only. Do not enable in production.
VENNEK_ENABLE_FIXTURES=false

# Future Cardano indexer configuration
BLOCKFROST_PROJECT_ID=
BLOCKFROST_NETWORK=mainnet
KOIOS_API_URL=
